---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 10);

const fmt = (date: Date) =>
	date.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
		timeZone: 'UTC',
	});
---

<BaseLayout
	title="Jared Korba"
	description="A digital garden — notes in progress, revised as I learn more."
	brandIsHeading
>
	<p class="lede">
		A digital garden. Notes in progress, planted early and revised as I learn more.
	</p>

	<h2>Recent</h2>
	{
		notes.length === 0 ? (
			<p class="meta">Nothing published yet.</p>
		) : (
			<ul class="note-list">
				{notes.map((note) => (
					<li>
						<h3 class="note-title"><a href={`/notes/${note.id}`}>{note.data.title}</a></h3>
						{note.data.description && <p>{note.data.description}</p>}
						<p class="meta">
							<time datetime={note.data.pubDate.toISOString()}>{fmt(note.data.pubDate)}</time>
						</p>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>
