---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (date: Date) =>
	date.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
		timeZone: 'UTC',
	});
---

<BaseLayout title="Notes — Jared Korba" description="Writing by Jared Korba.">
	<h1>Notes</h1>
	{
		notes.length === 0 ? (
			<p class="meta">Nothing published yet.</p>
		) : (
			<ul class="note-list">
				{notes.map((note) => (
					<li>
						<h2><a href={`/notes/${note.id}`}>{note.data.title}</a></h2>
						{note.data.description && <p>{note.data.description}</p>}
						<p class="meta">
							<time datetime={note.data.pubDate.toISOString()}>{fmt(note.data.pubDate)}</time>
						</p>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>
